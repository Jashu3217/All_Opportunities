# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:4200

# ── MongoDB Atlas ─────────────────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.mongodb.net/opportunityos?retryWrites=true&w=majority

# ── Redis (Upstash) ───────────────────────────────────────────────────────────
REDIS_URL=redis://:<password>@<host>:<port>

# ── Anthropic ─────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Cache TTLs (seconds) ──────────────────────────────────────────────────────
GOVT_CACHE_TTL=43200        # 12 hours
TECH_CACHE_TTL=3600         # 1 hour
TEACH_CACHE_TTL=86400       # 24 hours
FREELANCE_CACHE_TTL=86400   # 24 hours

# ── Rate limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000   # 15 min
RATE_LIMIT_MAX=100
